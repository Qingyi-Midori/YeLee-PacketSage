{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YeLee’ PacketSage",
  "version": "3.8.1",
  "identifier": "com.yelee.packetsage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YeLee’ PacketSage — 证据优先的抓包调查",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "externalBin": ["binaries/packetsage"],
    "resources": {
      "binaries/agent-sidecar": "agent-sidecar"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
